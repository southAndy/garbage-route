TAIPEI_GARBAGE_DATA_URL=https://data.taipei/api/dataset/6bb3304b-4f46-4bb0-8cd1-60c66dcd1cae/resource/a6e90031-7ec4-4089-afb5-361a4efe7202/download
NEW_TAIPEI_GARBAGE_DATA_URL=https://data.ntpc.gov.tw/api/datasets/edc3ad26-8ae7-4916-a00b-bc6048d19bf8/csv/file
# 正式網站網址，用於產生 robots.txt 與 sitemap.xml（請勿包含結尾斜線）
SITE_URL=https://example.com
# OpenFreeMap Liberty：免 API Key 的 OpenStreetMap 向量底圖
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# 地址查詢：Photon 相容服務；預設為公共 demo（僅適合低流量試用，可改成自架服務）
PHOTON_API_URL=https://photon.komoot.io/api/
# Tally 已發布表單的分享網址；留空時隱藏所有回饋入口
NEXT_PUBLIC_TALLY_FORM_URL=
# 一鍵問卷答案另存到 Google Sheet：Apps Script 網頁應用程式的 /exec 網址與相同的 secret（見 scripts/survey-sheet-webhook.gs）；留空時不另存
SURVEY_SHEET_WEBHOOK_URL=
SURVEY_SHEET_SECRET=
# 廣告位模式：placeholder 顯示固定尺寸的預覽框（本機看版面）；measure 不顯示任何東西、只送 ad_slot_viewed 事件量到達率（正式站）；留空或其他值一律關閉
NEXT_PUBLIC_ADS_MODE=
